# Realty Tracker configuration — copy to .env and fill in.
# .env holds real values and is gitignored. Never commit real secrets.

# --- Storage ---
DB_PATH=data/tracker.db

# --- Scheduling ---
# How often a tracking pass runs, in hours (several hours; never tight-loop).
POLL_INTERVAL_HOURS=6

# --- Web dashboard (local, loopback only) ---
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Networking ---
# Optional outbound proxy for scraping. Leave empty for none.
PROXY_URL=

# --- Scraping etiquette (§7) ---
# Randomized delay range (seconds) between network hits within a run.
SCRAPE_DELAY_MIN_SEC=2
SCRAPE_DELAY_MAX_SEC=5
# Block images/fonts/media while scraping (faster and politer). 1/0.
BLOCK_MEDIA=1
# Max search-result pages to walk per saved-search (keep small).
MAX_SEARCH_PAGES=1

# --- Browser (§7): for hostile anti-bot (Avito), drive a real browser ---
# Run a visible browser (0 = headful) — far less detectable than headless.
BROWSER_HEADLESS=1
# Use the installed Chrome instead of bundled Chromium (e.g. 'chrome'). Empty = Chromium.
BROWSER_CHANNEL=
# Persistent profile dir so cookies from a hand-solved challenge survive.
# Use a DEDICATED folder (not your main Chrome profile, which locks), e.g.
# data/browser-profile — first run headful, solve once, later runs reuse it.
BROWSER_USER_DATA_DIR=

# --- Change detection (§8.7) ---
# Mark a listing delisted only after this many consecutive misses (guards
# against a transient block causing a false "removed"). The dashboard may
# expose this later; for now it is env-configured.
DELIST_AFTER_MISSES=3

# --- Telegram notifications (optional) ---
# If the token or chat id is absent, Telegram is disabled and the rest still runs.
TELEGRAM_BOT_TOKEN=
# One or more recipient chat ids, comma-separated (every id gets each message).
# A bot only reaches chats it is told about — "subscribing" to it is not enough:
# each person must send the bot a message once, then run `python -m src.main
# chat-ids` to read their id and add it here. Example: 111111111,222222222
TELEGRAM_CHAT_ID=
# Also notify when a brand-new listing starts being tracked (not only on
# price changes / delistings). 1/0.
NOTIFY_ON_NEW=1
