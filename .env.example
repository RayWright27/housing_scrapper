# Realty Tracker configuration — copy to .env and fill in.
# .env holds real values and is gitignored. Never commit real secrets.

# --- Storage ---
DB_PATH=data/tracker.db

# --- Scheduling ---
# How often a tracking pass runs, in hours (several hours; never tight-loop).
POLL_INTERVAL_HOURS=6

# --- Web dashboard (local, loopback only) ---
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Networking ---
# Optional outbound proxy for scraping. Leave empty for none.
PROXY_URL=

# --- Scraping etiquette (§7) ---
# Randomized delay range (seconds) between network hits within a run.
SCRAPE_DELAY_MIN_SEC=2
SCRAPE_DELAY_MAX_SEC=5
# Block images/fonts/media while scraping (faster and politer). 1/0.
BLOCK_MEDIA=1
# Max search-result pages to walk per saved-search (keep small).
MAX_SEARCH_PAGES=1

# --- Change detection (§8.7) ---
# Mark a listing delisted only after this many consecutive misses (guards
# against a transient block causing a false "removed"). The dashboard may
# expose this later; for now it is env-configured.
DELIST_AFTER_MISSES=3

# --- Telegram notifications (optional) ---
# If both are absent, Telegram is disabled and the rest still runs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also notify when a brand-new listing starts being tracked (not only on
# price changes / delistings). 1/0.
NOTIFY_ON_NEW=1
