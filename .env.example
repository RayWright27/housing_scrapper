# Realty Tracker configuration — copy to .env and fill in.
# .env holds real values and is gitignored. Never commit real secrets.

# --- Storage ---
DB_PATH=data/tracker.db

# --- Scheduling ---
# How often a tracking pass runs, in hours (several hours; never tight-loop).
POLL_INTERVAL_HOURS=6

# --- Web dashboard (local, loopback only) ---
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Networking ---
# Optional outbound proxy for scraping. Leave empty for none.
PROXY_URL=

# --- Telegram notifications (optional) ---
# If both are absent, Telegram is disabled and the rest still runs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
